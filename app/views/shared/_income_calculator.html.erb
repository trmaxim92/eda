<div class="calc-layout" data-controller="income-calculator" data-income-calculator-rate-value="400">
  <div class="calculator">
    <div class="form-grid">
      <label>Тип курьера
        <select data-income-calculator-target="type" data-action="change->income-calculator#changeType">
          <option value="pedestrian">Пеший</option>
          <option value="bike">Вело</option>
          <option value="auto">Авто</option>
        </select>
      </label>
      <label>Часов в день
        <select data-income-calculator-target="hours" data-action="change->income-calculator#recalculate">
          <% (4..12).each do |h| %>
            <option value="<%= h %>" <%= "selected" if h == 8 %>><%= h %></option>
          <% end %>
        </select>
      </label>
      <label>Дней в неделю
        <select data-income-calculator-target="days" data-action="change->income-calculator#recalculate">
          <% (1..7).each do |d| %>
            <option value="<%= d %>" <%= "selected" if d == 5 %>><%= d %></option>
          <% end %>
        </select>
      </label>
      <label>Ориентир, ₽/час
        <select data-income-calculator-target="rate" data-action="change->income-calculator#recalculate">
          <% [300, 350, 400, 450, 500, 534].each do |rate| %>
            <option value="<%= rate %>" <%= "selected" if rate == 400 %>><%= rate %></option>
          <% end %>
        </select>
      </label>
    </div>
    <p class="disclaimer">Ориентир для Москвы: у пеших и вело — база до 110 ₽ за заказ + 30 ₽/км; у авто — база до 120 ₽ + 5 ₽ за минуту расчётного времени. Плюс доплаты за спрос, ожидание и сложность. Не гарантия дохода — сверяйте сумму в Яндекс Про.</p>
  </div>
  <div class="calc-result-card">
    <p class="label">Ориентировочно в месяц</p>
    <p class="value">≈ <span data-income-calculator-target="result">0</span> ₽</p>
    <p class="muted">Не гарантированный заработок</p>
  </div>
</div>
