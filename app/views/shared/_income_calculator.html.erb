<div class="calc-layout" data-controller="income-calculator" data-income-calculator-rate-value="<%= hourly_rate %>">
  <div class="calculator">
    <div class="form-grid">
      <label>Тип курьера
        <select data-income-calculator-target="type">
          <option value="pedestrian">Пеший</option>
          <option value="bike">Вело</option>
          <option value="auto">Авто</option>
        </select>
      </label>
      <label>Часов в день
        <select data-income-calculator-target="hours" data-action="change->income-calculator#recalculate">
          <% (4..12).each do |h| %>
            <option value="<%= h %>" <%= "selected" if h == 8 %>><%= h %></option>
          <% end %>
        </select>
      </label>
      <label>Дней в неделю
        <select data-income-calculator-target="days" data-action="change->income-calculator#recalculate">
          <% (1..7).each do |d| %>
            <option value="<%= d %>" <%= "selected" if d == 5 %>><%= d %></option>
          <% end %>
        </select>
      </label>
      <label>Ориентир ₽/час
        <select data-income-calculator-target="rate" data-action="change->income-calculator#recalculate">
          <% [250, 300, 350, 400, 450, 500].each do |rate| %>
            <option value="<%= rate %>" <%= "selected" if rate == hourly_rate.to_i %>>от <%= rate %> ₽</option>
          <% end %>
        </select>
      </label>
    </div>
    <p class="disclaimer">Расчёт является ориентировочным. Фактический доход зависит от количества заказов, города, времени работы, условий платформы и других факторов.</p>
  </div>
  <div class="calc-result-card">
    <div class="calc-chart" aria-hidden="true"></div>
    <div class="label">Ориентировочно</div>
    <div class="value">≈ <span data-income-calculator-target="result">0</span> ₽ <span class="value-suffix">в месяц</span></div>
  </div>
</div>
