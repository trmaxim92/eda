<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Отзывы</p>
      <h1><%= seo_meta[:h1] %></h1>
      <p class="lead">Реальные отзывы проходят модерацию. Мы не публикуем фиктивные истории.</p>
    </div>
    <div class="cards-3">
      <% @reviews.each do |review| %>
        <article class="review-card">
          <div class="review-top">
            <div class="avatar"><%= review.author_name.to_s.first %></div>
            <div>
              <strong><%= review.author_name %></strong>
              <div class="muted"><%= [review.city_name, review.courier_type_name, review.reviewed_on].compact.join(" · ") %></div>
            </div>
          </div>
          <p><%= review.body %></p>
        </article>
      <% end %>
    </div>
  </div>
</section>
