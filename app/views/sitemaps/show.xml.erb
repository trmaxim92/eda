<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <% @static_paths.each do |path| %>
    <url>
      <loc><%= "#{request.base_url}#{path}" %></loc>
      <changefreq>weekly</changefreq>
    </url>
  <% end %>
  <% @courier_types.each do |type| %>
    <url>
      <loc><%= "#{request.base_url}/#{type.slug}/" %></loc>
      <changefreq>weekly</changefreq>
    </url>
  <% end %>
  <% @cities.each do |city| %>
    <url>
      <loc><%= "#{request.base_url}/goroda/#{city.slug}/" %></loc>
      <changefreq>weekly</changefreq>
    </url>
  <% end %>
</urlset>
