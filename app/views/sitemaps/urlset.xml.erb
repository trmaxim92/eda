<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <% @entries.each do |entry| %>
    <url>
      <loc><%= entry[:loc] %></loc>
      <% if entry[:lastmod].present? %>
        <lastmod><%= entry[:lastmod].utc.iso8601 %></lastmod>
      <% end %>
      <changefreq>weekly</changefreq>
    </url>
  <% end %>
</urlset>
