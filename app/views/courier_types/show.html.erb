<article class="section">
  <div class="container narrow prose">
    <h1><%= @courier_type.h1.presence || @courier_type.name %></h1>
    <p class="lead"><%= @courier_type.description %></p>
    <% if @courier_type.features.present? %>
      <h2>Особенности</h2>
      <%= simple_format(@courier_type.features) %>
    <% end %>
    <% if @courier_type.requirements.present? %>
      <h2>Требования</h2>
      <%= simple_format(@courier_type.requirements) %>
    <% end %>
    <% if @courier_type.documents.present? %>
      <h2>Документы</h2>
      <%= simple_format(@courier_type.documents) %>
    <% end %>
    <% if @courier_type.how_to_start.present? %>
      <h2>Как начать</h2>
      <%= simple_format(@courier_type.how_to_start) %>
    <% end %>
    <% if @courier_type.earnings_info.present? %>
      <h2>О заработке</h2>
      <%= simple_format(@courier_type.earnings_info) %>
      <p class="disclaimer">Информация носит ориентировочный характер и не является гарантией дохода.</p>
    <% end %>
    <% if @courier_type.pros_cons.present? %>
      <h2>Плюсы и ограничения</h2>
      <%= simple_format(@courier_type.pros_cons) %>
    <% end %>
    <p class="related">
      <a href="<%= rabota_kurerom_path %>/">Работа курьером</a> ·
      <a href="<%= usloviya_raboty_path %>/">Условия</a> ·
      <a href="<%= rabota_cherez_park_path %>/">Через парк</a>
    </p>
  </div>
</article>

<section class="section section-soft" id="lead-form">
  <div class="container form-wrap">
    <div class="form-intro">
      <p class="eyebrow">Подключение</p>
      <h2>Подключиться</h2>
      <% if @referral_link.present? %>
        <p class="cta-row"><a class="btn btn-secondary" href="<%= register_path_for(courier_type: @courier_type) %>">Зарегистрироваться самостоятельно</a></p>
      <% else %>
        <p class="disclaimer">Кнопка самостоятельной регистрации временно недоступна — оставьте заявку.</p>
      <% end %>
    </div>
    <%= render "shared/lead_form", cities: @cities, courier_types: CourierType.published.ordered %>
  </div>
</section>

<% if @faqs.any? %>
<section class="section">
  <div class="container narrow">
    <h2>FAQ</h2>
    <%= render "shared/faq", faqs: @faqs %>
  </div>
</section>
<% end %>
