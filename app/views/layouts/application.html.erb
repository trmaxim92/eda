<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= meta_description %>">
    <meta name="robots" content="<%= robots_meta_content %>">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="120x120">
    <link rel="apple-touch-icon" href="/favicon.svg">
    <link rel="canonical" href="<%= canonical_url %>">
    <meta property="og:title" content="<%= seo_meta[:og_title].presence || page_title %>">
    <meta property="og:description" content="<%= seo_meta[:og_description].presence || meta_description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta name="twitter:card" content="summary_large_image">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "shared/schema", faqs: @faqs %>
    <% metrika_id = SiteSetting.get("yandex_metrika_id", "") rescue "" %>
    <% ga4_id = SiteSetting.get("ga4_id", "") rescue "" %>
    <% if metrika_id.present? %>
      <script>window.YANDEX_METRIKA_ID = <%= raw metrika_id.to_json %>;</script>
    <% end %>
    <% if ga4_id.present? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ga4_id %>"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= ga4_id %>', { anonymize_ip: true });
      </script>
    <% end %>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="<%= root_path %>">
          <span class="brand-mark">Еда</span>
          <span class="brand-text">Яндекс Еда</span>
        </a>
        <nav class="nav" aria-label="Основная навигация">
          <a href="<%= root_path %>#types">Форматы</a>
          <a href="<%= usloviya_raboty_path %>/">Условия</a>
          <a href="<%= goroda_path %>/">Города</a>
          <a href="<%= otzyvy_path %>/">Отзывы</a>
          <a href="<%= kontakty_path %>/">Контакты</a>
        </nav>
        <div class="header-actions">
          <a class="header-phone" href="tel:<%= (SiteSetting.get('contact_phone', '+78001234567') rescue '+78001234567').to_s.gsub(/[^\d+]/, '') %>">
            <%= SiteSetting.get("contact_phone", "+7 (800) 123-45-67") rescue "+7 (800) 123-45-67" %>
          </a>
          <a class="btn btn-primary btn-sm" href="#lead-form">Оставить заявку</a>
        </div>
      </div>
    </header>

    <% if notice.present? %><div class="flash flash-notice container"><%= notice %></div><% end %>
    <% if alert.present? %><div class="flash flash-alert container"><%= alert %></div><% end %>

    <main>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div class="footer-brand">
            <a class="brand" href="<%= root_path %>">
              <span class="brand-mark">Еда</span>
              <span class="brand-text">Яндекс Еда</span>
            </a>
            <p>Работа курьером в Яндекс Еде: форматы, города и заявка на подключение.</p>
          </div>
          <div class="footer-links">
            <a href="<%= rabota_kurerom_path %>/">Работа курьером</a>
            <a href="<%= usloviya_raboty_path %>/">Условия работы</a>
            <a href="<%= otzyvy_path %>/">Отзывы</a>
            <a href="<%= goroda_path %>/">Города</a>
            <a href="<%= kontakty_path %>/">Контакты</a>
          </div>
          <div class="footer-contacts">
            <a class="footer-phone" href="tel:<%= (SiteSetting.get('contact_phone', '+78001234567') rescue '+78001234567').to_s.gsub(/[^\d+]/, '') %>">
              <%= SiteSetting.get("contact_phone", "+7 (800) 123-45-67") rescue "+7 (800) 123-45-67" %>
            </a>
            <a href="mailto:<%= SiteSetting.get('contact_email', 'hello@park-dostavka.ru') rescue 'hello@park-dostavka.ru' %>">
              <%= SiteSetting.get("contact_email", "hello@park-dostavka.ru") rescue "hello@park-dostavka.ru" %>
            </a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© <%= Time.current.year %> Яндекс Еда</span>
          <span>Политика конфиденциальности · Обработка персональных данных</span>
        </div>
      </div>
    </footer>
  </body>
</html>
