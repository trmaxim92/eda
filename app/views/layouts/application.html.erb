<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= meta_description %>">
    <meta name="robots" content="<%= robots_meta_content %>">
    <link rel="canonical" href="<%= canonical_url %>">
    <meta property="og:title" content="<%= seo_meta[:og_title].presence || page_title %>">
    <meta property="og:description" content="<%= seo_meta[:og_description].presence || meta_description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta name="twitter:card" content="summary_large_image">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="<%= root_path %>">
          <span class="brand-mark" aria-hidden="true">📍</span>
          Парк Доставка
        </a>
        <nav class="nav" aria-label="Основная навигация">
          <a href="<%= rabota_v_yandex_eda_path %>/">Работа в Яндекс Еде</a>
          <a href="<%= usloviya_raboty_path %>/">Условия</a>
          <a href="<%= otzyvy_path %>/">Отзывы</a>
          <a href="<%= blog_path %>/">Блог</a>
          <a href="<%= goroda_path %>/">Города</a>
        </nav>
        <div class="header-actions">
          <a class="header-phone" href="tel:<%= (SiteSetting.get('contact_phone', '+78001234567') rescue '+78001234567').to_s.gsub(/[^\d+]/, '') %>">
            <%= SiteSetting.get("contact_phone", "+7 (800) 123-45-67") rescue "+7 (800) 123-45-67" %>
          </a>
          <a class="btn btn-primary btn-sm" href="#lead-form">Оставить заявку</a>
        </div>
      </div>
    </header>

    <% if notice.present? %><div class="flash flash-notice container"><%= notice %></div><% end %>
    <% if alert.present? %><div class="flash flash-alert container"><%= alert %></div><% end %>

    <main>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div>
            <a class="brand" href="<%= root_path %>">
              <span class="brand-mark">П</span>
              Парк Доставка
            </a>
            <p>Парк-партнёр для подключения курьеров к Яндекс Еде. Не является официальным сайтом Яндекса.</p>
          </div>
          <div class="footer-links">
            <a href="<%= rabota_kurerom_path %>/">Работа курьером</a>
            <a href="<%= usloviya_raboty_path %>/">Условия работы</a>
            <a href="<%= rabota_cherez_park_path %>/">Работа через парк</a>
            <a href="<%= otzyvy_path %>/">Отзывы</a>
            <a href="<%= goroda_path %>/">Города</a>
          </div>
          <div>
            <p><strong><%= SiteSetting.get("contact_phone", "+7 (800) 123-45-67") rescue "+7 (800) 123-45-67" %></strong></p>
            <p><%= SiteSetting.get("contact_email", "hello@park-dostavka.ru") rescue "hello@park-dostavka.ru" %></p>
            <div class="socials" aria-label="Соцсети">
              <a href="#" aria-label="Telegram">Tg</a>
              <a href="#" aria-label="VK">VK</a>
              <a href="#" aria-label="YouTube">YT</a>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© <%= Time.current.year %> Парк Доставка</span>
          <span>Политика конфиденциальности · Обработка персональных данных</span>
        </div>
      </div>
    </footer>
  </body>
</html>
