<%= form_with model: [:admin, template], class: "lead-form" do |f| %>
  <% if template.errors.any? %><div class="flash flash-alert"><%= template.errors.full_messages.to_sentence %></div><% end %>
  <div class="form-grid">
    <label>Название<%= f.text_field :name %></label>
    <label>Scope
      <%= f.select :scope, SeoTemplate::SCOPES %>
    </label>
  </div>
  <label>Title<%= f.text_field :title_template %></label>
  <label>Description<%= f.text_area :description_template, rows: 3 %></label>
  <label>H1<%= f.text_field :h1_template %></label>
  <label class="checkbox"><%= f.check_box :active %> Активен</label>
  <%= f.submit "Сохранить", class: "btn btn-primary" %>
<% end %>

<% if local_assigns[:preview] %>
  <div class="lead-form" style="margin-top:1rem">
    <h3>Preview</h3>
    <p><strong>Title:</strong> <%= preview[:title] %> (<%= preview[:title].length %>)</p>
    <p><strong>H1:</strong> <%= preview[:h1] %></p>
    <p><strong>Description:</strong> <%= preview[:description] %> (<%= preview[:description].length %>)</p>
    <% preview[:warnings].each do |w| %><p class="flash flash-alert"><%= w %></p><% end %>
  </div>
<% end %>
