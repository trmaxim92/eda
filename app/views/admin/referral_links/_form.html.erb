<%= form_with model: [:admin, referral_link], class: "lead-form" do |f| %>
  <% if referral_link.errors.any? %><div class="flash flash-alert"><%= referral_link.errors.full_messages.to_sentence %></div><% end %>
  <div class="form-grid">
    <label>Название<%= f.text_field :name %></label>
    <label>URL<%= f.url_field :url, placeholder: "https://eda.yandex.ru/..." %></label>
    <label>Город<%= f.collection_select :city_id, City.ordered, :id, :name, include_blank: "Любой" %></label>
    <label>Тип курьера<%= f.collection_select :courier_type_id, CourierType.ordered, :id, :name, include_blank: "Любой" %></label>
    <label>Приоритет<%= f.number_field :priority %></label>
  </div>
  <label>Описание<%= f.text_area :description, rows: 3 %></label>
  <label class="checkbox"><%= f.check_box :is_active %> Активна</label>
  <label class="checkbox"><%= f.check_box :is_default %> По умолчанию</label>
  <%= f.submit "Сохранить", class: "btn btn-primary" %>
<% end %>
