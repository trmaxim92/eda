<h1><%= @referral_link.name %></h1>
<div class="stats">
  <div class="stat"><span>Сегодня</span><strong><%= @clicks_today %></strong></div>
  <div class="stat"><span>Неделя</span><strong><%= @clicks_week %></strong></div>
  <div class="stat"><span>Месяц</span><strong><%= @clicks_month %></strong></div>
  <div class="stat"><span>Всего</span><strong><%= @referral_link.referral_clicks.count %></strong></div>
</div>
<p class="disclaimer">Переход по ссылке не равен регистрации.</p>
<table class="admin-table">
  <thead><tr><th>Время</th><th>Город</th><th>Тип</th><th>Страница</th><th>UTM</th></tr></thead>
  <tbody>
    <% @clicks.each do |click| %>
      <tr>
        <td><%= click.clicked_at %></td>
        <td><%= click.city&.name || "—" %></td>
        <td><%= click.courier_type&.name || "—" %></td>
        <td><%= click.landing_page %></td>
        <td><%= [click.utm_source, click.utm_campaign].compact.join(" / ") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
