<section class="hero">
  <div class="container hero-shell">
    <div class="hero-copy">
      <p class="eyebrow">Парк-партнёр · park-dostavka.ru</p>
      <h1>Работа курьером<br>в Яндекс Еде</h1>
      <p class="lead">Доставляйте заказы Яндекс Еды пешком, на велосипеде или авто. Подключение через наш парк или самостоятельно в Яндекс Про — гибкий график и выплаты по условиям сервиса.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#lead-form">Оставить заявку</a>
        <% if registration_available? %>
          <a class="btn btn-secondary" href="<%= go_register_path %>">Зарегистрироваться самостоятельно</a>
        <% else %>
          <a class="btn btn-secondary" href="#lead-form">Зарегистрироваться самостоятельно</a>
        <% end %>
      </div>
      <ul class="hero-usps">
        <li>Гибкий график</li>
        <li>Стабильные выплаты</li>
        <li>Поддержка 24/7</li>
      </ul>
    </div>
    <div class="hero-art">
      <img class="hero-courier" src="/images/hero-courier-v4.png" alt="Курьер Яндекс Еды">
    </div>
  </div>
</section>

<section class="section" id="types">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Форматы работы</p>
      <h2>Выберите способ доставки</h2>
    </div>
    <div class="cards-3">
      <% type_cards = [
        ["pedestrian", "Пеший курьер", "Доставка пешком по городу без автомобиля.", "/images/type-pedestrian.jpg", "rabota-peshim-kurerom"],
        ["bike", "Велокурьер", "Доставка на велосипеде — больше маршрутов и мобильности.", "/images/type-bike.jpg", "rabota-velokurerom"],
        ["auto", "Автокурьер", "Доставка на личном автомобиле на дальние заказы.", "/images/type-auto.jpg", "rabota-avtokurerom"]
      ] %>
      <% type_cards.each do |code, title, text, img, slug| %>
        <% type = @courier_types.find { |t| t.code == code } %>
        <a class="type-card" href="/<%= type&.slug || slug %>/">
          <div class="type-card-media" style="background-image:url('<%= img %>')"></div>
          <div class="type-card-body">
            <h3><%= type&.name || title %></h3>
            <p><%= text %></p>
            <span class="text-link">Подробнее</span>
          </div>
        </a>
      <% end %>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Процесс</p>
      <h2>Как начать работать</h2>
    </div>
    <ol class="steps-row">
      <li class="step-item">
        <span class="step-num">01</span>
        <h3>Выберите способ доставки</h3>
        <p>Пеший, вело или авто</p>
      </li>
      <li class="step-item">
        <span class="step-num">02</span>
        <h3>Укажите город</h3>
        <p>Где планируете работать</p>
      </li>
      <li class="step-item">
        <span class="step-num">03</span>
        <h3>Оставьте заявку</h3>
        <p>Или зарегистрируйтесь сами</p>
      </li>
      <li class="step-item">
        <span class="step-num">04</span>
        <h3>Подготовьте документы</h3>
        <p>Паспорт и данные для оформления</p>
      </li>
      <li class="step-item">
        <span class="step-num">05</span>
        <h3>Начните доставлять</h3>
        <p>После подтверждения подключения</p>
      </li>
    </ol>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="calc-panel">
      <div class="calc-panel-head">
        <p class="eyebrow">Калькулятор</p>
        <h2>Сколько можно зарабатывать</h2>
        <p>Ориентир по Москве на базе тарифов Яндекс Еды. Не гарантия дохода — сверяйте в Яндекс Про.</p>
      </div>
      <%= render "shared/income_calculator", hourly_rate: @hourly_rate %>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container why-grid">
    <div>
      <p class="eyebrow">Преимущества парка</p>
      <h2>Почему выбирают работу через наш парк</h2>
      <ul class="check-list">
        <li>Помощь с заявкой, документами и первым слотом</li>
        <li>Пеший, вело и авто — подскажем подходящий формат</li>
        <li>Поясним тарифы Москвы и как читать начисления в Про</li>
        <li>Можно зарегистрироваться самостоятельно по ссылке</li>
        <li>Сопровождение до выдачи экипировки</li>
        <li>Без обещаний «гарантированного» дохода — только ориентиры</li>
      </ul>
    </div>
    <div class="why-media">
      <div class="why-media-caption">
        <p>Готовы подключиться?</p>
        <a class="btn btn-primary" href="#lead-form">Оставить заявку</a>
      </div>
    </div>
  </div>
</section>

<% if @reviews.any? %>
<section class="section">
  <div class="container">
    <div class="section-head section-head-row">
      <div>
        <p class="eyebrow">Отзывы</p>
        <h2>Реальные отзывы курьеров</h2>
      </div>
      <a class="text-link" href="<%= otzyvy_path %>/">Все отзывы</a>
    </div>
    <div class="cards-3">
      <% @reviews.each do |review| %>
        <article class="review-card">
          <div class="review-top">
            <div class="avatar"><%= review.author_name.to_s.first %></div>
            <div>
              <strong><%= review.author_name %></strong>
              <div class="muted"><%= [review.city_name, review.courier_type_name].compact.join(" · ") %></div>
            </div>
          </div>
          <p><%= review.body %></p>
        </article>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<section class="section">
  <div class="container">
    <div class="final-cta">
      <div class="final-cta-inner">
        <p class="eyebrow eyebrow-light">Старт</p>
        <h2>Готовы начать</h2>
        <p>Оставьте заявку или зарегистрируйтесь самостоятельно. Представитель парка поможет на этапе подключения.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#lead-form">Оставить заявку</a>
          <% if registration_available? %>
            <a class="btn btn-ghost" href="<%= go_register_path %>">Зарегистрироваться самостоятельно</a>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-soft" id="lead-form">
  <div class="container form-wrap">
    <div class="form-intro">
      <p class="eyebrow">Заявка</p>
      <h2>Оставить заявку</h2>
      <p>Укажите контакты — свяжемся и подскажем по подключению.</p>
    </div>
    <%= render "shared/lead_form", cities: @cities, courier_types: @courier_types %>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <div class="section-head">
      <p class="eyebrow">FAQ</p>
      <h2>Частые вопросы</h2>
    </div>
    <%= render "shared/faq", faqs: @faqs %>
  </div>
</section>
