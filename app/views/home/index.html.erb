<section class="hero">
  <div class="container hero-shell">
    <div class="hero-copy">
      <p class="eyebrow">Парк-партнёр · park-dostavka.ru</p>
      <h1>Работа курьером<br>в Яндекс Еде</h1>
      <p class="lead">Подключение пеших, вело- и автокурьеров через парк или самостоятельно. Помогаем с заявкой, документами и первым слотом в Яндекс Про.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#lead-form">Оставить заявку</a>
        <% if registration_available? %>
          <a class="btn btn-secondary" href="<%= go_register_path %>">Зарегистрироваться самостоятельно</a>
        <% end %>
      </div>
      <ul class="hero-usps">
        <li>Гибкий график</li>
        <li>Выплаты по условиям сервиса</li>
        <li>Сопровождение парка</li>
      </ul>
    </div>
    <div class="hero-art">
      <img class="hero-courier" src="/images/hero-courier-v4.png" alt="Курьер Яндекс Еды">
    </div>
  </div>
</section>

<section class="section section-soft" id="city-select">
  <div class="container">
    <div class="section-head section-head-row">
      <div>
        <p class="eyebrow">Город</p>
        <h2>Выберите город</h2>
        <p class="section-lead">Покажем доступные форматы и ссылки для вашего города.</p>
      </div>
      <% if selected_city %>
        <div class="city-selected">
          <span>Сейчас: <strong><%= selected_city.name %></strong></span>
          <%= button_to "Сбросить", select_city_path, method: :delete, class: "btn btn-secondary btn-sm" %>
        </div>
      <% end %>
    </div>

    <%= form_with url: select_city_path, method: :post, class: "city-select-form", local: true do %>
      <label class="city-select-label">
        Ваш город
        <select name="city_slug" required onchange="this.form.requestSubmit()">
          <option value="">Выберите из списка</option>
          <% @cities.each do |city| %>
            <option value="<%= city.slug %>" <%= "selected" if selected_city&.id == city.id %>><%= city.name %></option>
          <% end %>
        </select>
      </label>
    <% end %>

    <% if selected_city %>
      <div class="city-regional-block">
        <p><strong><%= selected_city.name %></strong> — доступные форматы:</p>
        <div class="city-chip-row">
          <% if @selected_city_types.any? %>
            <% @selected_city_types.each do |type| %>
              <a class="city-chip" href="/<%= type.slug %>/"><%= type.name %></a>
            <% end %>
          <% else %>
            <span class="muted">Форматы уточним при заявке</span>
          <% end %>
        </div>
        <div class="cta-row">
          <a class="btn btn-primary" href="<%= gorod_path(selected_city) %>/">Страница города</a>
          <% if @selected_city_referral.present? %>
            <a class="btn btn-secondary" href="<%= register_path_for(city: selected_city) %>">Регистрация</a>
          <% end %>
          <a class="btn btn-secondary" href="#lead-form">Оставить заявку</a>
        </div>
      </div>
    <% end %>
  </div>
</section>

<section class="section" id="types">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Форматы</p>
      <h2>Выберите способ доставки</h2>
      <p class="section-lead">Один формат — одна страница с условиями. Подскажем, что подойдёт в вашем городе.</p>
    </div>
    <div class="cards-3">
      <% type_cards = [
        ["pedestrian", "Пеший курьер", "Короткие маршруты без транспорта. Заказы из ресторанов, магазинов и аптек.", "/images/type-pedestrian.jpg", "rabota-peshim-kurerom"],
        ["bike", "Велокурьер", "Больше точек за смену на своём или арендованном велосипеде.", "/images/type-bike.jpg", "rabota-velokurerom"],
        ["auto", "Автокурьер", "Дальние и мультизаказы на личном автомобиле.", "/images/type-auto.jpg", "rabota-avtokurerom"]
      ] %>
      <% type_cards.each do |code, title, text, img, slug| %>
        <% type = @courier_types.find { |t| t.code == code } %>
        <a class="type-card" href="/<%= type&.slug || slug %>/">
          <div class="type-card-media" style="background-image:url('<%= img %>')"></div>
          <div class="type-card-body">
            <h3><%= type&.name || title %></h3>
            <p><%= text %></p>
            <span class="text-link">Подробнее</span>
          </div>
        </a>
      <% end %>
    </div>
  </div>
</section>

<section class="section section-soft" id="how">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Процесс</p>
      <h2>Как начать</h2>
      <p class="section-lead">Четыре шага от заявки до первого слота.</p>
    </div>
    <ol class="steps-row steps-row-4">
      <li class="step-item">
        <span class="step-num">01</span>
        <h3>Формат и город</h3>
        <p>Пеший, вело или авто — где планируете работать</p>
      </li>
      <li class="step-item">
        <span class="step-num">02</span>
        <h3>Заявка или регистрация</h3>
        <p>Через парк или самостоятельно в Яндекс Про</p>
      </li>
      <li class="step-item">
        <span class="step-num">03</span>
        <h3>Документы и экипировка</h3>
        <p>Паспорт, обучение, термосумка в центре</p>
      </li>
      <li class="step-item">
        <span class="step-num">04</span>
        <h3>Первый слот</h3>
        <p>Выход на доставки после подтверждения</p>
      </li>
    </ol>
  </div>
</section>

<section class="section" id="park">
  <div class="container why-grid">
    <div>
      <p class="eyebrow">Парк</p>
      <h2>Зачем подключаться через парк</h2>
      <p class="section-lead">Парк Доставка — партнёр для оформления и старта. Не официальный сайт Яндекса.</p>
      <ul class="check-list">
        <li>Помощь с заявкой и документами</li>
        <li>Подскажем формат под ваш город</li>
        <li>Сопровождение до первого слота</li>
        <li>Можно зарегистрироваться самостоятельно</li>
      </ul>
      <p class="cta-row">
        <a class="btn btn-primary" href="#lead-form">Оставить заявку</a>
        <a class="btn btn-secondary" href="<%= usloviya_raboty_path %>/">Условия работы</a>
      </p>
    </div>
    <div class="why-panel">
      <p class="why-panel-title">Что нужно для старта</p>
      <ul class="why-panel-list">
        <li>Возраст от 18 лет</li>
        <li>Смартфон с Яндекс Про</li>
        <li>Паспорт и данные по гражданству</li>
        <li>Для авто — права и автомобиль</li>
      </ul>
      <a class="text-link" href="<%= rabota_cherez_park_path %>/">Как работает парк</a>
    </div>
  </div>
</section>

<% featured_cities = @cities.select { |c| %w[ufa moskva sankt-peterburg kazan ekaterinburg novosibirsk nizhniy-novgorod krasnodar].include?(c.slug) }.presence || @cities.first(8) %>
<% if featured_cities.any? %>
<section class="section section-soft" id="cities">
  <div class="container">
    <div class="section-head section-head-row">
      <div>
        <p class="eyebrow">Города</p>
        <h2>Где можно подключиться</h2>
      </div>
      <a class="text-link" href="<%= goroda_path %>/">Все города</a>
    </div>
    <div class="city-chip-row">
      <% featured_cities.each do |city| %>
        <a class="city-chip" href="<%= gorod_path(city) %>/"><%= city.name %></a>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<% if @reviews.any? %>
<section class="section" id="reviews">
  <div class="container">
    <div class="section-head section-head-row">
      <div>
        <p class="eyebrow">Отзывы</p>
        <h2>Что говорят курьеры</h2>
      </div>
      <a class="text-link" href="<%= otzyvy_path %>/">Все отзывы</a>
    </div>
    <div class="cards-3">
      <% @reviews.each do |review| %>
        <article class="review-card">
          <div class="review-top">
            <div class="avatar"><%= review.author_name.to_s.first %></div>
            <div>
              <strong><%= review.author_name %></strong>
              <div class="muted"><%= [review.city_name, review.courier_type_name].compact.join(" · ") %></div>
            </div>
          </div>
          <p><%= review.body %></p>
        </article>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<section class="section section-lead-band" id="lead-form">
  <div class="container form-wrap">
    <div class="form-intro">
      <p class="eyebrow eyebrow-light">Заявка</p>
      <h2>Оставить заявку</h2>
      <p>Укажите контакты — свяжемся и подскажем по подключению в вашем городе.</p>
      <% if registration_available? %>
        <p class="cta-row">
          <a class="btn btn-ghost" href="<%= go_register_path %>">Зарегистрироваться самостоятельно</a>
        </p>
      <% end %>
    </div>
    <%= render "shared/lead_form", cities: @cities, courier_types: @courier_types %>
  </div>
</section>

<% if @faqs.any? %>
<section class="section" id="faq">
  <div class="container narrow">
    <div class="section-head">
      <p class="eyebrow">FAQ</p>
      <h2>Частые вопросы</h2>
    </div>
    <%= render "shared/faq", faqs: @faqs %>
  </div>
</section>
<% end %>
