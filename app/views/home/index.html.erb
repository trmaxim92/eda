<section class="hero">
  <div class="container hero-grid">
    <div>
      <span class="pill">Работа курьером в Яндекс Еде</span>
      <h1><%= seo_meta[:h1] %></h1>
      <p class="lead">Начните доставлять заказы пешком, на велосипеде или автомобиле. Узнайте условия подключения и выберите удобный способ регистрации.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#lead-form">Оставить заявку →</a>
        <% if registration_available? %>
          <a class="btn btn-secondary" href="<%= go_register_path %>">Зарегистрироваться самостоятельно</a>
        <% end %>
      </div>
      <ul class="hero-usps">
        <li><span class="usp-icon">⚡</span> Гибкий график</li>
        <li><span class="usp-icon">₽</span> Стабильные выплаты</li>
        <li><span class="usp-icon">🎧</span> Поддержка 24/7</li>
      </ul>
    </div>
    <div class="hero-visual" role="img" aria-label="Курьер Яндекс Еды"></div>
  </div>
</section>

<section class="section" id="types">
  <div class="container">
    <div class="section-head">
      <h2>Выберите способ доставки</h2>
      <p>Подберите формат под свой ритм и возможности</p>
    </div>
    <div class="cards-3">
      <% type_media = {
        "pedestrian" => "https://images.unsplash.com/photo-1526367790996-3e4c9584ff1f?auto=format&fit=crop&w=900&q=80",
        "bike" => "https://images.unsplash.com/photo-1571068316344-75bc76f77890?auto=format&fit=crop&w=900&q=80",
        "auto" => "https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?auto=format&fit=crop&w=900&q=80"
      } %>
      <% @courier_types.each do |type| %>
        <a class="type-card" href="/<%= type.slug %>/">
          <div class="type-card-media" style="background-image:url('<%= type_media[type.code] || type_media['pedestrian'] %>')"></div>
          <div class="type-card-body">
            <div>
              <h3><%= type.name %></h3>
              <p><%= truncate(type.description.to_s, length: 90) %></p>
            </div>
            <span class="btn-icon" aria-hidden="true">→</span>
          </div>
        </a>
      <% end %>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="section-head">
      <h2>Как начать работать?</h2>
      <p>Простой путь от заявки до первых заказов</p>
    </div>
    <div class="steps-row">
      <div class="step-item">
        <div class="step-num">1</div>
        <h3>Выберите способ</h3>
        <p>Пеший, вело или авто</p>
      </div>
      <div class="step-item">
        <div class="step-num">2</div>
        <h3>Укажите город</h3>
        <p>Где планируете работать</p>
      </div>
      <div class="step-item">
        <div class="step-num">3</div>
        <h3>Оставьте заявку</h3>
        <p>Или зарегистрируйтесь сами</p>
      </div>
      <div class="step-item">
        <div class="step-num">4</div>
        <h3>Подготовьте документы</h3>
        <p>Паспорт и данные для оформления</p>
      </div>
      <div class="step-item">
        <div class="step-num">5</div>
        <h3>Начните доставлять</h3>
        <p>После подтверждения подключения</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-yellow">
  <div class="container">
    <div class="section-head">
      <h2>Сколько можно зарабатывать?</h2>
      <p>Ориентировочный расчёт — не гарантия дохода</p>
    </div>
    <%= render "shared/income_calculator", hourly_rate: @hourly_rate %>
  </div>
</section>

<section class="section">
  <div class="container why-grid">
    <div>
      <h2>Почему выбирают работу через наш парк?</h2>
      <ul class="check-list">
        <li><span class="check">✓</span> Помощь при подключении</li>
        <li><span class="check">✓</span> Гибкий график, если это допускают условия</li>
        <li><span class="check">✓</span> Консультации по вопросам работы</li>
        <li><span class="check">✓</span> Прозрачные условия сотрудничества</li>
        <li><span class="check">✓</span> Возможность самостоятельной регистрации</li>
        <li><span class="check">✓</span> Быстрый старт после подтверждения</li>
      </ul>
    </div>
    <div class="why-media">
      <a class="btn btn-primary why-cta" href="#lead-form">Вступить в команду курьеров!</a>
    </div>
  </div>
</section>

<% if @reviews.any? %>
<section class="section section-soft">
  <div class="container">
    <div class="section-head">
      <h2>Реальные отзывы курьеров</h2>
      <p>Публикуем только модерированные отзывы</p>
    </div>
    <div class="cards-3">
      <% @reviews.each do |review| %>
        <article class="review-card">
          <div class="review-top">
            <div class="avatar"><%= review.author_name.to_s.first %></div>
            <div>
              <strong><%= review.author_name %></strong>
              <div class="muted"><%= [review.city_name, review.courier_type_name].compact.join(" · ") %></div>
            </div>
          </div>
          <p><%= review.body %></p>
          <div class="stars" aria-label="Оценка 5 из 5">★★★★★</div>
        </article>
      <% end %>
    </div>
    <p style="margin-top:1.25rem"><a class="btn btn-secondary btn-sm" href="<%= otzyvy_path %>/">Читать все отзывы</a></p>
  </div>
</section>
<% end %>

<section class="section">
  <div class="container">
    <div class="final-cta" id="final-cta">
      <div class="final-cta-inner">
        <h2>Готовы начать?</h2>
        <p>Оставьте заявку или зарегистрируйтесь самостоятельно — и начните доставлять заказы после подключения.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#lead-form">Оставить заявку</a>
          <% if registration_available? %>
            <a class="btn btn-secondary" href="<%= go_register_path %>">Зарегистрироваться самостоятельно</a>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-soft" id="lead-form">
  <div class="container narrow">
    <div class="section-head">
      <h2>Оставить заявку</h2>
      <p>Представитель парка свяжется с вами. Самостоятельная регистрация доступна отдельно.</p>
    </div>
    <%= render "shared/lead_form", cities: @cities, courier_types: @courier_types %>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <div class="section-head">
      <h2>Частые вопросы</h2>
    </div>
    <%= render "shared/faq", faqs: @faqs %>
  </div>
</section>
