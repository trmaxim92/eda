<section class="hero">
  <div class="container hero-shell">
    <div class="hero-copy">
      <span class="pill">Работа курьером в Яндекс Еде</span>
      <h1>Работа курьером<br>в Яндекс Еде</h1>
      <p class="lead">Начните доставлять заказы пешком, на велосипеде или автомобиле.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#lead-form">Оставить заявку <span aria-hidden="true">→</span></a>
        <% if registration_available? %>
          <a class="btn btn-secondary" href="<%= go_register_path %>">Зарегистрироваться самостоятельно</a>
        <% else %>
          <a class="btn btn-secondary" href="#lead-form">Зарегистрироваться самостоятельно</a>
        <% end %>
      </div>
      <ul class="hero-usps">
        <li>
          <span class="usp-icon usp-bolt" aria-hidden="true"></span>
          Гибкий график
        </li>
        <li>
          <span class="usp-icon usp-rub" aria-hidden="true">₽</span>
          Стабильные выплаты
        </li>
        <li>
          <span class="usp-icon usp-head" aria-hidden="true"></span>
          Поддержка 24/7
        </li>
      </ul>
    </div>
    <div class="hero-art">
      <img class="hero-city" src="/images/hero-city.jpg" alt="" aria-hidden="true">
      <img class="hero-courier" src="/images/hero-courier.png" alt="Курьер Яндекс Еды">
    </div>
  </div>
</section>

<section class="section" id="types">
  <div class="container">
    <div class="section-head center">
      <h2>Выберите способ доставки</h2>
    </div>
    <div class="cards-3">
      <% type_cards = [
        ["pedestrian", "Пеший курьер", "Доставка пешком по городу без автомобиля.", "https://images.unsplash.com/photo-1526367790996-3e4c9584ff1f?auto=format&fit=crop&w=900&q=80", "rabota-peshim-kurerom"],
        ["bike", "Велокурьер", "Доставка на велосипеде — больше мобильности.", "https://images.unsplash.com/photo-1571068316344-75bc76f77890?auto=format&fit=crop&w=900&q=80", "rabota-velokurerom"],
        ["auto", "Автокурьер", "Доставка на личном автомобиле.", "https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?auto=format&fit=crop&w=900&q=80", "rabota-avtokurerom"]
      ] %>
      <% type_cards.each do |code, title, text, img, slug| %>
        <% type = @courier_types.find { |t| t.code == code } %>
        <a class="type-card" href="/<%= type&.slug || slug %>/">
          <div class="type-card-media" style="background-image:url('<%= img %>')"></div>
          <div class="type-card-body">
            <div>
              <h3><%= type&.name || title %></h3>
              <p><%= text %></p>
            </div>
            <span class="btn-icon" aria-hidden="true">→</span>
          </div>
        </a>
      <% end %>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="section-head center">
      <h2>Как начать работать?</h2>
    </div>
    <div class="steps-row">
      <div class="step-item">
        <div class="step-num">1</div>
        <div class="step-ico">🖱️</div>
        <h3>Выберите способ доставки</h3>
      </div>
      <div class="step-item">
        <div class="step-num">2</div>
        <div class="step-ico">📍</div>
        <h3>Укажите город</h3>
      </div>
      <div class="step-item">
        <div class="step-num">3</div>
        <div class="step-ico">✅</div>
        <h3>Оставьте заявку или зарегистрируйтесь</h3>
      </div>
      <div class="step-item">
        <div class="step-num">4</div>
        <div class="step-ico">📄</div>
        <h3>Подготовьте документы</h3>
      </div>
      <div class="step-item">
        <div class="step-num">5</div>
        <div class="step-ico">🚀</div>
        <h3>Начните доставлять заказы</h3>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="calc-panel">
      <div class="calc-panel-head">
        <h2>Сколько можно<br>зарабатывать?</h2>
        <p>Ориентировочный расчёт — не гарантия дохода</p>
      </div>
      <%= render "shared/income_calculator", hourly_rate: @hourly_rate %>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container why-grid">
    <div>
      <h2>Почему выбирают работу<br>через наш парк?</h2>
      <ul class="check-list two-col">
        <li><span class="check">✓</span> Помощь при подключении</li>
        <li><span class="check">✓</span> Прозрачные условия</li>
        <li><span class="check">✓</span> Удобный график*</li>
        <li><span class="check">✓</span> Самостоятельная регистрация</li>
        <li><span class="check">✓</span> Поддержка 24/7</li>
        <li><span class="check">✓</span> Быстрый старт</li>
      </ul>
      <p class="disclaimer">*если это допускают действующие условия платформы</p>
    </div>
    <div class="why-media">
      <a class="btn btn-primary why-cta" href="#lead-form">Присоединяйтесь к команде курьеров! →</a>
    </div>
  </div>
</section>

<% if @reviews.any? %>
<section class="section">
  <div class="container">
    <div class="section-head center">
      <h2>Реальные отзывы курьеров</h2>
    </div>
    <div class="cards-3">
      <% @reviews.each do |review| %>
        <article class="review-card">
          <div class="review-top">
            <div class="avatar"><%= review.author_name.to_s.first %></div>
            <div>
              <strong><%= review.author_name %></strong>
              <div class="muted"><%= review.city_name %></div>
            </div>
          </div>
          <p><%= review.body %></p>
          <div class="stars" aria-label="Оценка 5 из 5">★★★★★</div>
        </article>
      <% end %>
    </div>
    <div class="center" style="margin-top:1.5rem">
      <a class="btn btn-primary btn-sm" href="<%= otzyvy_path %>/">Читать все отзывы →</a>
    </div>
  </div>
</section>
<% end %>

<section class="section">
  <div class="container">
    <div class="final-cta">
      <div class="final-cta-inner">
        <h2>Готовы начать?</h2>
        <p>Оставьте заявку или зарегистрируйтесь самостоятельно — и начните доставлять заказы после подключения.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#lead-form">Оставить заявку</a>
          <% if registration_available? %>
            <a class="btn btn-secondary" href="<%= go_register_path %>">Зарегистрироваться самостоятельно</a>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-soft" id="lead-form">
  <div class="container narrow">
    <div class="section-head center">
      <h2>Оставить заявку</h2>
      <p>Представитель парка свяжется с вами</p>
    </div>
    <%= render "shared/lead_form", cities: @cities, courier_types: @courier_types %>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <div class="section-head center">
      <h2>Частые вопросы</h2>
    </div>
    <%= render "shared/faq", faqs: @faqs %>
  </div>
</section>
