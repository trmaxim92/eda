<section class="section">
  <div class="container">
    <h1><%= seo_meta[:h1] %></h1>
    <p class="lead">Города, где доступно подключение курьеров через парк Park Dostavka.</p>
    <div class="cards-3">
      <% @cities.each do |city| %>
        <a class="type-card" href="<%= gorod_path(city) %>/">
          <h3><%= city.name %></h3>
          <p><%= city.region %></p>
        </a>
      <% end %>
    </div>
  </div>
</section>
